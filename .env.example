# =============================================================
# TinDo — Variáveis de ambiente (template)
# =============================================================
# Copie pra .env.local e preencha. NUNCA commite .env.local.

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://cpcglkytrtkisrehqvsc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use APENAS em Edge Functions ou server-side. NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Todoist -----
# Em produção: guardar em Supabase Vault (todoist_tokens), NUNCA no client.
# Em dev local, só pra testar Edge Function localmente:
TODOIST_TOKEN_DEV=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
TODOIST_WEBHOOK_SECRET=

# ----- IA (Claude API / Anthropic SDK) -----
# Classificação alta-frequência (mais barato)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Recalibração + raciocínio profundo
ANTHROPIC_MODEL_DEEP=claude-sonnet-4-6

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ----- Feature flags (Fase atual) -----
NEXT_PUBLIC_FEATURE_AI=false
NEXT_PUBLIC_FEATURE_TODOIST_SYNC=false
NEXT_PUBLIC_FEATURE_AUDIO=true
NEXT_PUBLIC_FEATURE_HAPTIC=true

# DEV-ONLY: pula auth e abre /feed direto. Sempre false em prod.
NEXT_PUBLIC_DEV_SKIP_AUTH=false
